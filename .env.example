# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ids_ips
DB_USER=ids_admin
DB_PASSWORD=secure_password

# Network
NETWORK_INTERFACE=eth0
CAPTURE_FILTER=
PACKET_BATCH_SIZE=100
AGGREGATION_WINDOW=10

# AI
CONTAMINATION=0.1
N_ESTIMATORS=100
TRAINING_SAMPLES=10000

# Risk
RISK_LOW_MAX=0.3
RISK_MEDIUM_MAX=0.7

# IPS
BLOCK_DURATION=3600
MAX_BLOCK_DURATION=86400
RECIDIVE_MULTIPLIER=2.0
AUTO_BLOCK_CRITICAL=true

# Alerts SMTP
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=admin@example.com
SMTP_USE_TLS=true

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
SECRET_KEY=change-this-to-a-secure-random-string
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Logging
LOG_LEVEL=INFO

# Whitelist
AUTO_WHITELIST_PRIVATE=true
WHITELIST_IPS=

# Scanner
SCAN_INTERVAL=300
SCAN_TARGETS=192.168.1.0/24

# Hybrid
OFFLINE_FIRST=true
CONNECTIVITY_CHECK_INTERVAL=30
CONNECTIVITY_CHECK_TIMEOUT=3
CONNECTIVITY_CHECK_URLS=http://clients3.google.com/generate_204,http://ip-api.com,https://www.google.com/generate_204

# Chatbot IA hybride
CHATBOT_ENABLED=true
CHATBOT_LOCAL_ENABLED=true
CHATBOT_CLOUD_ENABLED=true
CHATBOT_PROVIDER=gemini
CHATBOT_MODEL=gemini-2.0-flash
CHATBOT_REDACT_IPS_FOR_CLOUD=true
GEMINI_API_KEY=
# Option legacy (si vous remettez CHATBOT_PROVIDER=groq)
GROQ_API_KEY=
