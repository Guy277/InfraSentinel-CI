# ============================================
# InfraSentinel-CI - Configuration Hackathon
# Mode offline: cloud desactive, local uniquement
# ============================================

# Core
LOG_LEVEL=INFO
NETWORK_INTERFACE=auto
CAPTURE_MODE=live

# AI Detection
AI_MODEL_ENABLED=true
AUTO_TRAIN_ENABLED=false
DETECTION_THRESHOLD=0.7

# Auto-Response
AUTO_BLOCK_CRITICAL=true
AUTO_BLOCK_HIGH=true
AUTO_BLOCK_MEDIUM=false

# Chatbot - HACKATHON MODE (offline)
CHATBOT_ENABLED=true
CHATBOT_LOCAL_ENABLED=true
CHATBOT_CLOUD_ENABLED=true
CHATBOT_PROVIDER=gemini

# Webhooks (desactives pour hackathon)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Retraining
RETRAIN_ENABLED=false
